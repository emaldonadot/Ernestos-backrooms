  m_Script: {fileID: 11500000, guid: 2d35d141d739f7aa5970ad5e28e34607, type: 3}
  m_Name: 
  m_EditorClassIdentifier: EndlessRooms.Player::EndlessRooms.Player.CassetteMessagePlayer
  _cassetteItem: {fileID: 11400000, guid: 2f9b6c93e7d858c159a0aeaa62342581, type: 2}
  _recorderItem: {fileID: 11400000, guid: 6667b61110e7133be91b323c98a5c2ff, type: 2}
  _inventory: {fileID: 1976084106}
  _messageText: "(A woman's voice, half-buried in tape hiss)\n\n\"...if anyone finds
    this \u2014 there's a UV bulb in the maintenance kit. Power it up and use it
    in the men's room, there's something written on the wall that doesn't show under
    normal light. And if you need a bronze key for anything, check R09 \u2014 it's
    just sitting there on the desk.\""
